PORT=3000
ANTHROPIC_API_KEY=

# GitHub App (required)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_REPOS=owner/repo1,owner/repo2,owner/repo3

# GitLab (optional — set all three to enable, or leave blank to disable)
GITLAB_URL=https://gitlab.com
GITLAB_ACCESS_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_REPOS=namespace/repo1,namespace/repo2
